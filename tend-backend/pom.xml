<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- Spring Boot parent: manages dependency versions, plugins, and build defaults. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<!-- Project identification and metadata. -->
	<groupId>com.drewweise</groupId>
	<artifactId>tend-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Tend Backend</name>
	<description>Backend for the tend personal food-planning system.</description>

	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<!-- Java version used to compile and run the application. -->
	<properties>
		<java.version>25</java.version>
	</properties>

	<dependencies>

		<!-- Spring Data JPA: provides Hibernate ORM, entity mapping,
             and repositories for Tend's application database. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Spring JDBC: provides JdbcTemplate for executing direct SQL queries,
             including queries against the USDA food database. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>

		<!-- OAuth2 Resource Server: validates JWT access tokens
             to protect backend API endpoints using AWS Cognito. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
		</dependency>

		<!-- Spring Web MVC: provides REST controllers, request routing,
             JSON responses, and embedded web server support. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Spring Boot DevTools: enables development conveniences
             such as automatic application restarts after code changes. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- MySQL Connector/J: JDBC driver used to connect
             Spring Boot to local or hosted MySQL databases. -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- JPA testing: provides tools for testing entities,
             repositories, and database persistence behavior. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Spring Security testing: provides utilities for testing
             authenticated requests, authorization, and security rules. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Spring Web MVC testing: provides tools for testing
             REST controllers and HTTP endpoints. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<!-- Maven build configuration. -->
	<build>
		<plugins>

			<!-- Spring Boot Maven Plugin: packages the application
                 as an executable JAR and supports spring-boot:run. -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

		</plugins>
	</build>

</project>
